                <mxCell id="vm-granja-srv" value="&lt;b&gt;granja1-srv (Gateway Industrial Edge)&lt;/b&gt;&lt;br&gt;Hardware industrial simulat (Advantech UNO)&lt;br&gt;&lt;b&gt;LAN Granja: 10.1.1.10&lt;/b&gt; | &lt;b&gt;IP VPN: 10.0.100.10&lt;/b&gt;&lt;br&gt;----------------------------------------------&lt;br&gt;• Broker MQTT Local (Edge Computing)&lt;br&gt;• &lt;b&gt;Control autònom d'emergència:&lt;/b&gt;&lt;br&gt;  Activa ventilació si Temp &amp;gt; 31ºC sense Internet&lt;br&gt;• &lt;b&gt;Buffer Store-and-Forward:&lt;/b&gt;&lt;br&gt;  Reté fins a 72h de telemetria si cau VPN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;align=left;spacingLeft=12;" parent="box-granja" vertex="1">
                    <mxGeometry x="25" y="45" width="330" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="vm-granja-sim" value="&lt;b&gt;granja1-sim (Simulador IoT)&lt;/b&gt;&lt;br&gt;&lt;b&gt;LAN Granja: 10.1.1.20&lt;/b&gt; (GW: 10.1.1.10)&lt;br&gt;----------------------------------------------&lt;br&gt;• &lt;b&gt;Bus Sèrie RS485 (Modbus RTU):&lt;/b&gt;&lt;br&gt;  3x SHT30 Temp/Humitat per nau&lt;br&gt;  1x Sensor CO2 Senseair S8 per nau&lt;br&gt;  1x Comptador d'aigua per impulsos&lt;br&gt;• &lt;b&gt;Ràdio LoRaWAN 868 MHz:&lt;/b&gt;&lt;br&gt;  2x Kits cèl·lules pesatge silos de gra&lt;br&gt;• Emulador Python: &lt;code&gt;simulador_iot.py&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;align=left;spacingLeft=12;" parent="box-granja" vertex="1">
                    <mxGeometry x="25" y="270" width="330" height="155" as="geometry"/>
                </mxCell>
                <mxCell id="vm-granja2-note" value="&lt;b&gt;Granja 2 (Variació Requeriment 4.7)&lt;/b&gt;&lt;br&gt;Subxarxa clonada: &lt;b&gt;10.1.2.0/24&lt;/b&gt; | IP VPN: &lt;b&gt;10.0.100.20&lt;/b&gt;&lt;br&gt;Creada automàticament en &amp;lt; 10 segons mitjançant &lt;code&gt;alta_granja.sh&lt;/code&gt;&lt;br&gt;(Alta atòmica a MariaDB + OpenLDAP + OPNsense)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#F3F4F6;strokeColor=#9CA3AF;fontColor=#4B5563;" parent="box-granja" vertex="1">
