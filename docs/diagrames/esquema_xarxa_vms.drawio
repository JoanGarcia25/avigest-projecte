        <mxCell id="box-granja" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#F87171;fontStyle=1;fontColor=#991B1B;startSize=28;" value="GRANJA 1 PILOT (Explotació Remota) — Subxarxa 10.1.1.0/24" vertex="1">
