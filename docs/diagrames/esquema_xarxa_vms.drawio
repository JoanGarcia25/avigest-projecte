        </mxCell>
        <mxCell id="vm-fw" parent="box-cpd" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontColor=#991B1B;strokeWidth=2;" value="&lt;b&gt;fw-seu (OPNsense 24.x)&lt;/b&gt; — Tallafocs Perimetral 3 Potes + WireGuard Server (10.0.100.1)&lt;br&gt;&lt;font color=&quot;#DC2626&quot;&gt;&lt;b&gt;Política: Default DROP (Bloqueig per defecte)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;WAN: 10.0.2.x | DMZ: 10.0.10.1 | LAN: 10.0.20.1" vertex="1">
          <mxGeometry height="68" width="640" x="30" y="40" as="geometry" />
        </mxCell>
        <mxCell id="box-dmz" parent="box-cpd" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontStyle=1;fontColor=#92400E;startSize=26;" value="ZONA DESMILITARITZADA (DMZ) — VLAN 10 (10.0.10.0/24)" vertex="1">
          <mxGeometry height="120" width="640" x="30" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vm-dmz" parent="box-dmz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;fontColor=#78350F;" value="&lt;b&gt;dmz-web (Ubuntu Server 24.04 LTS)&lt;/b&gt; — IP: &lt;b&gt;10.0.10.10&lt;/b&gt; (GW: 10.0.10.1)&lt;br&gt;Nginx Reverse Proxy + WAF + Certificats SSL/TLS&lt;br&gt;&lt;i&gt;Accés autoritzat des de WAN només per Llista Blanca (Port 443)&lt;/i&gt;" vertex="1">
          <mxGeometry height="62" width="590" x="25" y="40" as="geometry" />
        </mxCell>
        <mxCell id="box-lan" parent="box-cpd" style="swimlane;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontStyle=1;fontColor=#065F46;startSize=26;" value="XARXA INTERNA CORPORATIVA (LAN SEU) — VLAN 20 (10.0.20.0/24)" vertex="1">
          <mxGeometry height="315" width="640" x="30" y="320" as="geometry" />
        </mxCell>
        <mxCell id="vm-serveis" parent="box-lan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#059669;fontColor=#064E3B;align=left;spacingLeft=15;" value="&lt;b&gt;srv-serveis (Ubuntu Server 24.04 LTS + Docker)&lt;/b&gt; — IP: &lt;b&gt;10.0.20.10&lt;/b&gt; (GW: 10.0.20.1)&lt;br&gt;Contenidors Docker de Negoci:&lt;br&gt;• &lt;b&gt;avigest_mariadb&lt;/b&gt; (MariaDB 10.11: Port 3306) + Triggers &amp; Vistes&lt;br&gt;• &lt;b&gt;avigest_mariadb_replica&lt;/b&gt; (Standby GTID: Port 3307)&lt;br&gt;• &lt;b&gt;avigest_mosquitto&lt;/b&gt; (Broker MQTT Central: Port 1883)&lt;br&gt;• &lt;b&gt;avigest_ldap&lt;/b&gt; (OpenLDAP: Port 389/636) &amp; phpLDAPadmin (:8081)" vertex="1">
          <mxGeometry height="120" width="590" x="25" y="40" as="geometry" />
        </mxCell>
        <mxCell id="vm-backup" parent="box-lan" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DEF7EC;strokeColor=#31C48D;fontColor=#03543F;align=left;spacingLeft=15;" value="&lt;b&gt;srv-backup (Ubuntu Server 24.04 LTS) — Servidor Dedicat PRD&lt;/b&gt; — IP: &lt;b&gt;10.0.20.20&lt;/b&gt; (GW: 10.0.20.1)&lt;br&gt;• Còpies programades Cron a les 02:00 AM (Buidatges lògics mariadb-dump + slapcat)&lt;br&gt;• &lt;b&gt;2n Disc Virtual Separat&lt;/b&gt; muntat a &lt;code&gt;/mnt/disc-extern-backup/&lt;/code&gt; (Model 3-2-1)&lt;br&gt;• Xifratge i sumes de verificació SHA-256 (Retenció 30 dies | RTO &amp;lt; 30 min)" vertex="1">
          <mxGeometry height="85" width="590" x="25" y="205" as="geometry" />
        </mxCell>
        <mxCell id="lbl-cron" parent="box-lan" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=9;fontColor=#047857;fillColor=#ECFDF5;rounded=1;" value="Cron 02:00 AM (mariadb-dump + slapcat)" vertex="1">
          <mxGeometry height="20" width="180" x="130" y="173" as="geometry" />
        </mxCell>
