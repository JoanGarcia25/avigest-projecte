        <mxCell id="vpn-cloud" parent="box-wan" style="shape=cube;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;darkOpacity=0.05;darkOpacity2=0.1;size=10;fillColor=#EDE9FE;strokeColor=#8B5CF6;fontColor=#5B21B6;" value="&lt;b&gt;Túnel VPN WireGuard (wg0)&lt;/b&gt;&lt;br&gt;Xarxa Virtual: &lt;b&gt;10.0.100.0/24&lt;/b&gt;&lt;br&gt;Port UDP 51820 (Xifrat ChaCha20)" vertex="1">
