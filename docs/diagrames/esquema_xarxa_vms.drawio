        <mxCell id="box-cpd" parent="1" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#60A5FA;fontStyle=1;fontColor=#1E40AF;startSize=28;" value="SEU CENTRAL AVIGEST (CPD) — Virtualització i Seguretat Perimetral" vertex="1">
